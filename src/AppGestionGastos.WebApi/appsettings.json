{
  "ConnectionStrings": {
    "DefaultConnection": "CONEXION_BASE_DE_DATOS"
  },
  "Jwt": {
    "Issuer": "AppGestionGastos",
    "Audience": "AppGestionGastos.Clients",
    "SecretKey": "REEMPLAZAR_ESTA_CLAVE_EN_TU_ARCHIVO_LOCAL",
    "ExpirationMinutes": 60
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning"
      }
    }
  },
  "LogSinks": {
    "Console": {
      "Enabled": true,
      "MinimumLevel": "Information"
    },
    "File": {
      "Enabled": true,
      "Path": "logs/app-.log",
      "RollingInterval": "Day",
      "RetainedFileCountLimit": 14,
      "MinimumLevel": "Information"
    },
    "Database": {
      "Enabled": true,
      "ConnectionStringName": "DefaultConnection",
      "SchemaName": "dbo",
      "TableName": "Logs",
      "AutoCreateTable": false,
      "MinimumLevel": "Information",
      "BatchPostingLimit": 100,
      "BatchPeriodSeconds": 5
    }
  },
  "LogRetention": {
    "Enabled": true,
    "RetentionMonths": 3,
    "IntervalHours": 24,
    "BatchSize": 5000
  },
  "DbCommandTiming": {
    "Enabled": true,
    "WarningThresholdMs": 1000,
    "ErrorThresholdMs": 3000,
    "IncludeCommandText": true,
    "MaxCommandTextLength": 2000
  },
  "CatalogCache": {
    "Enabled": true,
    "Expiration": "00:30:00",
    "LocalCacheExpiration": "00:05:00",
    "CacheSearches": false
  },
  "AllowedHosts": "*"
}
